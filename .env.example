# Database. POSTGRES_PASSWORD is read by docker-compose and must match the
# password embedded in DATABASE_URL.
POSTGRES_PASSWORD="change-me-strong-password"
DATABASE_URL="postgresql://tracker:change-me-strong-password@localhost:5433/team_tracker?schema=public"

# Auth (required).
#   AUTH_SECRET:   32+ byte random string, signs session cookies.
#                  Generate with: openssl rand -hex 32
#   AUTH_PASSWORD: the shared password users type to sign in.
AUTH_SECRET="generate-with-openssl-rand-hex-32"
AUTH_PASSWORD="choose-a-strong-password"
