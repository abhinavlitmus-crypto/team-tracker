# Database. POSTGRES_PASSWORD is read by docker-compose and must match the
# password embedded in DATABASE_URL.
POSTGRES_PASSWORD="change-me-strong-password"
DATABASE_URL="postgresql://tracker:change-me-strong-password@localhost:5433/team_tracker?schema=public"
# Direct (non-pooled) connection for `prisma migrate`. Locally, same as DATABASE_URL.
# On Neon: DATABASE_URL = pooled string (host contains "-pooler"), DIRECT_URL = direct string.
DIRECT_URL="postgresql://tracker:change-me-strong-password@localhost:5433/team_tracker?schema=public"

# Auth (required).
#   AUTH_SECRET:   32+ byte random string, signs session cookies.
#                  Generate with: openssl rand -hex 32
#   AUTH_PASSWORD: setup key used once, to create the first admin account.
AUTH_SECRET="generate-with-openssl-rand-hex-32"
AUTH_PASSWORD="choose-a-strong-password"
